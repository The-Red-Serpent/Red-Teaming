
configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: " Apps ";
    display-run: " Run ";
    display-window: " Windows ";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
    terminal: "kitty";
    sort: true;
    matching: "fuzzy";
    hover-select: false;
}

@theme "~/.config/rofi/theme.rasi"
